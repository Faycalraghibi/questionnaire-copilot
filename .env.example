# Copy to .env. Every variable used by the product is listed here.

# PostgreSQL (docker-compose.yml). Host port 5433 avoids a clash with a local PostgreSQL on 5432.
POSTGRES_USER=qc
POSTGRES_PASSWORD=qc
POSTGRES_DB=qc
POSTGRES_PORT=5433
DATABASE_URL=postgresql://qc:qc@localhost:5433/qc

# Embeddings (e5 | fake for offline unit tests)
EMBED_PROVIDER=e5
EMBED_MODEL=intfloat/multilingual-e5-small

# Retrieval thresholds (calibrated on Questionnaire A)
REUSE_THRESHOLD=0.92
MIN_EVIDENCE=0.541

# LLM provider: openai | anthropic | stub
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MAX_EVAL_COST_USD=1.00

# UI and API
REVIEWERS=Amira Haddad,Lucas Meyer,Priya Nair
API_URL=http://127.0.0.1:8000
